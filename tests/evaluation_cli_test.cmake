# Verify option errors are raised before any file, camera, or accelerator is opened.
function(reject_case expected)
  execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(status EQUAL 0 OR NOT "${err}" MATCHES "${expected}")
    message(FATAL_ERROR "Unexpected CLI result for ${ARGN}: status=${status}, error=${err}")
  endif()
endfunction()
reject_case("--tracking must be" --tracking guessed)
reject_case("requires live Coral" --tracking yolo --demo)
reject_case("requires live Coral" --tracking compare --no-coral)
reject_case("requires live Coral" --tracking yolo --calibrate)
reject_case("requires --detector yolov8" --tracking compare --detector ssd)
reject_case("--person-confidence must be" --person-confidence nan)
reject_case("--person-confidence must be" --person-confidence 1.1)
reject_case("Person size limits must be" --person-max-width 0)
reject_case("Person size limits must be" --person-max-height 1.5)
reject_case("--yolo-coordinates must be" --yolo-coordinates guessed)
reject_case("--yolo-profile must be" --yolo-profile guessed)
reject_case("--yolo-profile requires --detector yolov8" --yolo-profile figure --detector ssd)
reject_case("--person-confidence must be" --yolo-profile figure --target-confidence nan)
